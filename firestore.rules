rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function zeroOrAbsent(d, k) { return !(k in d) || d[k] == 0; }

    function createClean(d) {
      return !d.keys().hasAny([
          'verified', 'isVerified', 'kycVerified', 'kycStatus', 'tier3Status',
          'role', 'isAdmin', 'tier', 'dailyLimit', 'monthlyLimit', 'singleLimit'
        ])
        && zeroOrAbsent(d, 'balance') && zeroOrAbsent(d, 'nairaBalance')
        && zeroOrAbsent(d, 'dollarBalance') && zeroOrAbsent(d, 'walletBalance')
        && zeroOrAbsent(d, 'dailySpent') && zeroOrAbsent(d, 'monthlySpent');
    }

    function updateClean() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
          'balance', 'nairaBalance', 'dollarBalance', 'walletBalance',
          'lockedBalance', 'inTransit', 'cashback', 'vouchers',
          'verified', 'isVerified', 'kycVerified', 'tier', 'role', 'isAdmin',
          'dailySpent', 'monthlySpent', 'dailyLimit', 'monthlyLimit', 'singleLimit',
          'accountNumber', 'dollarAccountNumber'
        ])
        && (!('kycStatus' in changed) || request.resource.data.kycStatus == 'pending')
        && (!('tier3Status' in changed) || request.resource.data.tier3Status == 'pending');
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && createClean(request.resource.data);
      allow update: if isOwner(uid) && updateClean();
      allow delete: if false;
    }

    // Gift cards: read-only for the sender or the person who redeemed. Only the server writes.
    match /giftcards/{cardId} {
      allow read: if signedIn() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.get('receiverId', '') == request.auth.uid);
      allow write: if false;
    }

    // Notifications: the owner can read them and mark them read. Only the server creates them.
    match /users/{uid}/notifications/{nid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
