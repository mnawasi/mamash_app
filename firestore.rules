rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function zeroOrAbsent(d, k) {
      return !(k in d) || d[k] == 0;
    }

    // A new account may not start with money, verification, or special roles.
    function createClean(d) {
      return !d.keys().hasAny([
          'verified', 'isVerified', 'kycVerified', 'kycStatus',
          'role', 'isAdmin', 'tier',
          'dailyLimit', 'monthlyLimit', 'singleLimit'
        ])
        && zeroOrAbsent(d, 'balance')
        && zeroOrAbsent(d, 'nairaBalance')
        && zeroOrAbsent(d, 'dollarBalance')
        && zeroOrAbsent(d, 'walletBalance')
        && zeroOrAbsent(d, 'dailySpent')
        && zeroOrAbsent(d, 'monthlySpent');
    }

    // Users may edit their own profile, but never money, verification or limits.
    function updateClean() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
          'balance', 'nairaBalance', 'dollarBalance', 'walletBalance',
          'lockedBalance', 'inTransit', 'cashback', 'vouchers',
          'verified', 'isVerified', 'kycVerified',
          'tier', 'role', 'isAdmin',
          'dailySpent', 'monthlySpent',
          'dailyLimit', 'monthlyLimit', 'singleLimit',
          'accountNumber', 'dollarAccountNumber'
        ])
        // The app may only ever mark KYC as "pending". Only your server sets verified/rejected.
        && (!('kycStatus' in changed) || request.resource.data.kycStatus == 'pending');
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && createClean(request.resource.data);
      allow update: if isOwner(uid) && updateClean();
      allow delete: if false;
    }

    // Everything else is blocked until you add a rule for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
